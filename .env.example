MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=
APP_TIMEZONE=Africa/Lagos

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
